# Email address where new orders are sent (required for notifications)
ORDER_EMAIL=your@email.com

# Stripe: required for accepting card payments. Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Optional: SMTP to actually send email. If not set, orders are only logged to the console.
# Example (Gmail with app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your@gmail.com

# Server port (default 3001)
# PORT=3001

# When deployed, set this to your site URL so the server accepts requests from your domain.
# For yesmagicshop.com:
# ALLOWED_ORIGINS=https://yesmagicshop.com,https://www.yesmagicshop.com
# ALLOWED_ORIGINS=

# Admin inventory: use the same value as VITE_ADMIN_PASSWORD on the frontend so the admin page can save inventory to the server.
# ADMIN_PASSWORD=your-admin-password
