# Copy this to .env.production and fill in your real values before deploying.
# These are used when you run: npm run build
# Site domain: yesmagicshop.com

# Your live order server URL (e.g. after deploying the server to Render/Railway)
# Example: https://yesmagic-server.onrender.com/api/order or https://api.yesmagicshop.com/api/order
VITE_ORDER_API_URL=https://your-app-name.onrender.com/api/order

# Stripe live publishable key (pk_live_...) when you're ready for real payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Optional: admin password for /admin in production
# VITE_ADMIN_PASSWORD=

# The Spellbook (spellbook.yesmagicshop.com) — Supabase project URL + anon key (safe in browser; RLS enforces per-user rows)
# SPELLBOOK_SUPABASE_URL=https://xxxx.supabase.co
# SPELLBOOK_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional: if Spellbook is on another host, set API origin for trade-offer emails (injected into config.js)
# SPELLBOOK_TRADE_NOTIFY_BASE=https://yesmagicshop.com
# Trade-offer email function also needs on Netlify (not in this file): SPELLBOOK_SUPABASE_SERVICE_ROLE_KEY, SPELLBOOK_PUBLIC_URL, SMTP_*, ALLOWED_ORIGINS
